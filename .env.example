# MISEVA local environment — copy to .env and fill in. Never commit .env.
APP_ENV=local

DB_HOST=localhost
DB_PORT=5432
DB_NAME=misva
DB_OWNER_USER=misva_owner
DB_OWNER_PASSWORD=change-me
DB_APP_USER=misva_app
DB_APP_PASSWORD=change-me

JWT_SECRET=change-me-min-32-chars
REDIS_URL=
STORAGE_LOCAL_PATH=./storage
